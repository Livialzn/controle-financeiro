CREATE OR REPLACE VIEW vw_relatorio_financeiro AS
SELECT
t.id,
t.descricao,
t.valor,
t.tipo,
c.nome AS categoria,
t.data_movimento,
t.observacao,
t.criado_em
FROM transacoes t
LEFT JOIN categorias c
ON c.id = t.categoria_id;



CREATE OR REPLACE VIEW vw_resumo_geral AS
SELECT


COALESCE(
    SUM(
        CASE
            WHEN tipo = 'entrada'
            THEN valor
            ELSE 0
        END
    ),
    0
) AS total_entradas,

COALESCE(
    SUM(
        CASE
            WHEN tipo = 'saida'
            THEN valor
            ELSE 0
        END
    ),
    0
) AS total_saidas,

COALESCE(
    SUM(
        CASE
            WHEN tipo = 'entrada'
            THEN valor
            ELSE 0
        END
    ),
    0
)
-
COALESCE(
    SUM(
        CASE
            WHEN tipo = 'saida'
            THEN valor
            ELSE 0
        END
    ),
    0
) AS saldo_atual


FROM transacoes;



CREATE OR REPLACE VIEW vw_resumo_mensal AS
SELECT


DATE_TRUNC('month', data_movimento)::DATE AS mes,

SUM(
    CASE
        WHEN tipo = 'entrada'
        THEN valor
        ELSE 0
    END
) AS entradas,

SUM(
    CASE
        WHEN tipo = 'saida'
        THEN valor
        ELSE 0
    END
) AS saidas,

SUM(
    CASE
        WHEN tipo = 'entrada'
        THEN valor
        ELSE -valor
    END
) AS saldo


FROM transacoes
GROUP BY 1
ORDER BY 1;



CREATE OR REPLACE FUNCTION saldo_total()
RETURNS NUMERIC
LANGUAGE SQL
AS $$
SELECT
COALESCE(
SUM(
CASE
WHEN tipo = 'entrada'
THEN valor
ELSE -valor
END
),
0
)
FROM transacoes;
$$;



