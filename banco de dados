-- ===========================
-- VIEW DE RELATÓRIO
-- ===========================

CREATE OR REPLACE VIEW vw_relatorio_financeiro AS
SELECT
    t.id,
    t.descricao,
    t.valor,
    t.tipo,
    c.nome AS categoria,
    t.data_movimento,
    t.observacao
FROM transacoes t
LEFT JOIN categorias c
ON c.id = t.categoria_id;

-- ===========================
-- FUNÇÃO SALDO TOTAL
-- ===========================

CREATE OR REPLACE FUNCTION saldo_total()
RETURNS NUMERIC
LANGUAGE plpgsql
AS $$
DECLARE
    total_entradas NUMERIC := 0;
    total_saidas NUMERIC := 0;
BEGIN

    SELECT COALESCE(SUM(valor), 0)
    INTO total_entradas
    FROM transacoes
    WHERE tipo = 'entrada';

    SELECT COALESCE(SUM(valor), 0)
    INTO total_saidas
    FROM transacoes
    WHERE tipo = 'saida';

    RETURN total_entradas - total_saidas;
END;
$$;

-- ===========================
-- VIEW RESUMO GERAL
-- ===========================

CREATE OR REPLACE VIEW vw_resumo_geral AS
SELECT
    COALESCE(
        SUM(CASE WHEN tipo = 'entrada' THEN valor ELSE 0 END),
        0
    ) AS total_entradas,

    COALESCE(
        SUM(CASE WHEN tipo = 'saida' THEN valor ELSE 0 END),
        0
    ) AS total_saidas,

    COALESCE(
        SUM(CASE WHEN tipo = 'entrada' THEN valor ELSE 0 END),
        0
    ) -
    COALESCE(
        SUM(CASE WHEN tipo = 'saida' THEN valor ELSE 0 END),
        0
    ) AS saldo_atual

FROM transacoes;

