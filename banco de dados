-- =====================================================

-- ===========================
-- TABELA DE CATEGORIAS
-- ===========================

CREATE TABLE IF NOT EXISTS categorias (
id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

```
nome VARCHAR(100) NOT NULL UNIQUE,

tipo VARCHAR(20) NOT NULL
    CHECK (tipo IN ('entrada', 'saida')),

criado_em TIMESTAMP DEFAULT NOW(),

atualizado_em TIMESTAMP DEFAULT NOW()
```

);

-- ===========================
-- TABELA DE TRANSAÇÕES
-- ===========================

CREATE TABLE IF NOT EXISTS transacoes (
id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

```
descricao TEXT NOT NULL,

valor NUMERIC(12,2) NOT NULL
    CHECK (valor > 0),

tipo VARCHAR(20) NOT NULL
    CHECK (tipo IN ('entrada', 'saida')),

categoria_id BIGINT,

data_movimento DATE NOT NULL DEFAULT CURRENT_DATE,

observacao TEXT,

criado_em TIMESTAMP DEFAULT NOW(),

atualizado_em TIMESTAMP DEFAULT NOW(),

CONSTRAINT transacoes_categoria_id_fkey
    FOREIGN KEY (categoria_id)
    REFERENCES categorias(id)
    ON DELETE RESTRICT
```

);

-- ===========================
-- ÍNDICES
-- ===========================

CREATE INDEX IF NOT EXISTS idx_transacoes_tipo
ON transacoes(tipo);

CREATE INDEX IF NOT EXISTS idx_transacoes_data
ON transacoes(data_movimento);

CREATE INDEX IF NOT EXISTS idx_transacoes_categoria
ON transacoes(categoria_id);

-- ===========================
-- TRIGGER DE UPDATED_AT
-- ===========================

CREATE OR REPLACE FUNCTION atualizar_timestamp()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
NEW.atualizado_em = NOW();
RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_categorias_updated ON categorias;
CREATE TRIGGER trg_categorias_updated
BEFORE UPDATE ON categorias
FOR EACH ROW
EXECUTE FUNCTION atualizar_timestamp();

DROP TRIGGER IF EXISTS trg_transacoes_updated ON transacoes;
CREATE TRIGGER trg_transacoes_updated
BEFORE UPDATE ON transacoes
FOR EACH ROW
EXECUTE FUNCTION atualizar_timestamp();

-- ===========================
-- VALIDAÇÃO CATEGORIA X TIPO
-- ===========================

CREATE OR REPLACE FUNCTION validar_categoria_tipo()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
categoria_tipo VARCHAR(20);
BEGIN

```
IF NEW.categoria_id IS NULL THEN
    RETURN NEW;
END IF;

SELECT tipo
INTO categoria_tipo
FROM categorias
WHERE id = NEW.categoria_id;

IF categoria_tipo IS NOT NULL
   AND categoria_tipo <> NEW.tipo THEN

    RAISE EXCEPTION
        'Tipo da categoria (%) diferente do tipo da transação (%)',
        categoria_tipo,
        NEW.tipo;
END IF;

RETURN NEW;
```

END;
$$;

DROP TRIGGER IF EXISTS trg_validar_categoria_tipo ON transacoes;
CREATE TRIGGER trg_validar_categoria_tipo
BEFORE INSERT OR UPDATE
ON transacoes
FOR EACH ROW
EXECUTE FUNCTION validar_categoria_tipo();

