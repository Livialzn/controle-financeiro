# =========================================================
# ANÁLISE FINANCEIRA
# =========================================================

def analisar_financas():

    transacoes = buscar_transacoes()

    if not transacoes:

        print(
            "\n❌ Nenhuma transação cadastrada."
        )

        return

    entradas = 0.0

    saidas = 0.0

    for item in transacoes:

        valor = float(
            item["valor"]
        )

        if item["tipo"] == "entrada":

            entradas += valor

        elif item["tipo"] == "saida":

            saidas += valor

    saldo = entradas - saidas

    print("\n======================================")
    print("          ANÁLISE FINANCEIRA")
    print("======================================")

    print(
        f"\nEntradas: {formatar_dinheiro(entradas)}"
    )

    print(
        f"Saídas:   {formatar_dinheiro(saidas)}"
    )

    print(
        f"Saldo:    {formatar_dinheiro(saldo)}"
    )

    if entradas > 0:

        percentual = (
            saidas / entradas
        ) * 100

        print(
            f"\nVocê utilizou "
            f"{percentual:.2f}% "
            f"das suas entradas."
        )

    if saldo > 0:

        print(
            "\n✅ Situação financeira positiva."
        )

    elif saldo == 0:

        print(
            "\n⚠️ Entradas e saídas estão equilibradas."
        )

    else:

        print(
            "\n❌ Situação financeira negativa."
        )


# =========================================================
# EXCLUIR TRANSAÇÃO
# =========================================================

def excluir_transacao():

    transacoes = buscar_transacoes()

    if not transacoes:

        print(
            "\n❌ Nenhuma transação cadastrada."
        )

        return

    print("\n======================================")
    print("          EXCLUIR TRANSAÇÃO")
    print("======================================")

    for numero, item in enumerate(
        transacoes,
        start=1
    ):

        print(
            f"{numero} - "
            f"{item['data_movimento']} | "
            f"{item['descricao']} | "
            f"{formatar_dinheiro(float(item['valor']))}"
        )

    print(
        "0 - Cancelar"
    )

    try:

        opcao = int(
            input(
                "\nEscolha: "
            )
        )

        if opcao == 0:

            return

        if opcao < 1 or opcao > len(transacoes):

            print(
                "\n❌ Opção inválida."
            )

            return

        transacao = transacoes[
            opcao - 1
        ]

        confirmar = input(
            "\nConfirma a exclusão? (S/N): "
        ).strip().upper()

        if confirmar != "S":

            print(
                "\n❌ Operação cancelada."
            )

            return

        user_id = pegar_usuario_id()

        (
            supabase
            .table("transacoes")
            .delete()
            .eq(
                "id",
                transacao["id"]
            )
            .eq(
                "user_id",
                user_id
            )
            .execute()
        )

        print(
            "\n✅ Transação excluída."
        )

    except ValueError:

        print(
            "\n❌ Digite um número válido."
        )

    except Exception as erro:

        print(
            "\n❌ Erro ao excluir:"
        )

        print(erro)


