# =========================================================
# LER NÚMERO
# =========================================================

def ler_numero(mensagem):

    while True:

        try:

            valor = input(
                mensagem
            ).strip()

            valor = valor.replace(
                ",",
                "."
            )

            numero = float(
                valor
            )

            if numero <= 0:

                print(
                    "❌ Digite um valor maior que zero."
                )

                continue

            return numero

        except ValueError:

            print(
                "❌ Digite um valor válido."
            )


# =========================================================
# LER DATA
# =========================================================

def ler_data(mensagem):

    while True:

        valor = input(
            mensagem
        ).strip()

        formatos = [
            "%d/%m/%Y",
            "%d-%m-%Y",
            "%d%m%Y"
        ]

        for formato in formatos:

            try:

                data = datetime.datetime.strptime(
                    valor,
                    formato
                )

                return data.strftime(
                    "%Y-%m-%d"
                )

            except ValueError:

                pass

        print(
            "❌ Data inválida."
        )


