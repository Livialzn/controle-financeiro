# FILTRO DE PERÍODO
# =========================================================

def escolher_periodo():
    hoje = datetime.date.today()

    print("\n===== PERÍODO =====")
    print("1 - Hoje")
    print("2 - Ontem")
    print("3 - Últimos 7 dias")
    print("4 - Últimos 30 dias")
    print("5 - Últimos 6 meses")
    print("6 - Este mês")
    print("7 - Mês passado")
    print("8 - Personalizado")
    print("9 - Todos")

    while True:
        opcao = input("Escolha: ")

        if opcao == "1":
            return hoje.isoformat(), hoje.isoformat()

        elif opcao == "2":
            data = hoje - datetime.timedelta(days=1)
            return data.isoformat(), data.isoformat()

        elif opcao == "3":
            inicio = hoje - datetime.timedelta(days=6)
            return inicio.isoformat(), hoje.isoformat()

        elif opcao == "4":
            inicio = hoje - datetime.timedelta(days=29)
            return inicio.isoformat(), hoje.isoformat()

        elif opcao == "5":
            inicio = subtrair_meses(hoje, 6)
            return inicio.isoformat(), hoje.isoformat()

        elif opcao == "6":
            inicio = hoje.replace(day=1)
            return inicio.isoformat(), hoje.isoformat()

        elif opcao == "7":
            primeiro_deste_mes = hoje.replace(day=1)
            ultimo_mes_passado = primeiro_deste_mes - datetime.timedelta(days=1)

            inicio = ultimo_mes_passado.replace(day=1)
            fim = ultimo_mes_passado

            return inicio.isoformat(), fim.isoformat()

        elif opcao == "8":
            print("\nData inicial:")
            inicio = ler_data()

            print("Data final:")
            fim = ler_data()

            return inicio, fim

        elif opcao == "9":
            return None, None

        else:
            print("Opção inválida.")


