    )

def ver_historico():

    dados = (
        supabase
        .table("vw_relatorio_financeiro")
        .select("*")
        .order(
            "data_movimento",
            desc=True
        )
        .execute()
    )

    print(
        "\n===== HISTÓRICO DE TRANSAÇÕES ====="
    )

    if not dados.data:
        print("Nenhuma transação cadastrada.")
        return

    for item in dados.data:

        print(
            f"{item['data_movimento']} | "
            f"{item['tipo']} | "
            f"{item['categoria']} | "
            f"R$ {float(item['valor']):.2f} | "
            f"{item['descricao']}"
        )

def analisar_financas():

    resumo = (
        supabase
        .table("vw_resumo_geral")
        .select("*")
        .execute()
    )

    if not resumo.data:
        print("Sem dados.")
        return

    dados = resumo.data[0]

    entradas = float(
        dados["total_entradas"]
    )

    saidas = float(
        dados["total_saidas"]
    )

    saldo = float(
        dados["saldo_atual"]
    )

    print(
        "\n===== ANÁLISE FINANCEIRA ====="
    )

    print(
        f"Entradas: R$ {entradas:.2f}"
    )

    print(
        f"Saídas: R$ {saidas:.2f}"
    )

    print(
        f"Saldo: R$ {saldo:.2f}"
    )

    if saldo >= 0:
        print(
            "\n✅ Situação financeira positiva."
        )
    else:
        print(
            "\n❌ Situação financeira negativa."
        )

def ler_numero(msg):
    while True:
        try:
            return float(input(msg))
        except ValueError:
            print("Digite um valor válido.")

def ler_data(msg):
    while True:

        valor = input(msg)

        formatos = [
            "%d/%m/%Y",
            "%d-%m-%Y",
            "%d%m%Y"
        ]

        for formato in formatos:
            try:
                return datetime.datetime.strptime(
                    valor,
                    formato
                ).strftime("%Y-%m-%d")
            except ValueError:
                pass

        print(
            "Data inválida."
        )
