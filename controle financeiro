# =========================================================
# BUSCAR CATEGORIAS
# =========================================================

def buscar_categorias(tipo):

    try:

        resultado = (
            supabase
            .table("categorias")
            .select("id, nome")
            .eq("tipo", tipo)
            .order("nome")
            .execute()
        )

        return resultado.data

    except Exception as erro:

        print(
            "\n❌ Erro ao buscar categorias:"
        )

        print(erro)

        return []


# =========================================================
# ESCOLHER CATEGORIA
# =========================================================

def escolher_categoria(tipo):

    categorias = buscar_categorias(tipo)

    if not categorias:

        print(
            "\n❌ Nenhuma categoria encontrada."
        )

        return None

    print(
        "\nCategorias disponíveis:"
    )

    for numero, categoria in enumerate(
        categorias,
        start=1
    ):

        print(
            f"{numero} - {categoria['nome']}"
        )

    while True:

        try:

            opcao = int(
                input(
                    "\nEscolha a categoria: "
                )
            )

            if 1 <= opcao <= len(categorias):

                return categorias[
                    opcao - 1
                ]["id"]

            print(
                "\n❌ Categoria inválida."
            )

        except ValueError:

            print(
                "\n❌ Digite um número."
            )


