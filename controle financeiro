def calcular_saldo():
    resultado = (
        supabase
        .table("vw_resumo_geral")
        .select("*")
        .execute()
    )

    if resultado.data:
        return float(
            resultado.data[0]["saldo_atual"]
        )

    return 0.0

def ver_saldo():
    saldo = calcular_saldo()

    print(
