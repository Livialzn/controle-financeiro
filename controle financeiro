        float(t["valor"])
        for t in transacoes
        if t["tipo"] == "entrada"
    )

    despesas = sum(
        float(t["valor"])
        for t in transacoes
        if t["tipo"] == "saida"
    )

    saldo = receitas - despesas

    if receitas > 0:
        percentual_gasto = (despesas / receitas) * 100
    else:
        percentual_gasto = 0

    print("\n===== ANÁLISE FINANCEIRA =====")
    print(f"Total de receitas: {formatar_dinheiro(receitas)}")
    print(f"Total de despesas: {formatar_dinheiro(despesas)}")
    print(f"Saldo: {formatar_dinheiro(saldo)}")
    print(f"Percentual gasto: {percentual_gasto:.2f}%")

    if despesas >= receitas:
        print("🚨 ALERTA: seus gastos já atingiram ou ultrapassaram o total recebido.")
        print("Sua conta está zerada ou negativa.")

    elif percentual_gasto > 70:
        print("⚠️ ATENÇÃO: você já gastou mais de 70% do que recebeu.")
