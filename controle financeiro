def ler_data():
    while True:
        data = input("Data (DD/MM/AAAA ou DDMMAAAA): ").strip()

        formatos = [
            "%d/%m/%Y",
            "%d%m%Y"
        ]

        for formato in formatos:
            try:
                return datetime.datetime.strptime(
                    data, formato
                ).date().isoformat()
            except ValueError:
                pass

        print("Data inválida.")

def subtrair_meses(data, meses):
    """
    Subtrai meses mantendo o máximo possível o dia original.
    Exemplo:
    31/03 - 1 mês = 28/02
    """
    ano = data.year
    mes = data.month - meses

    while mes <= 0:
        mes += 12
        ano -= 1

    dia = min(data.day, calendar.monthrange(ano, mes)[1])

    return datetime.date(ano, mes, dia)


