# =========================================================
# FORMATAÇÃO DE DINHEIRO
# =========================================================

def formatar_dinheiro(valor):

    return (
        f"R$ {valor:,.2f}"
        .replace(",", "X")
        .replace(".", ",")
        .replace("X", ".")
    )


# =========================================================
# CADASTRO DE USUÁRIO
# =========================================================

def cadastrar_usuario():

    print("\n======================================")
    print("          CADASTRO DE USUÁRIO")
    print("======================================")

    nome = input("Nome: ").strip()

    email = input("E-mail: ").strip()

    senha = input("Senha: ").strip()

    confirmar_senha = input(
        "Confirmar senha: "
    ).strip()

    if not nome:

        print("\n❌ Informe o nome.")

        return

    if not email:

        print("\n❌ Informe o e-mail.")

        return

    if not senha:

        print("\n❌ Informe a senha.")

        return

    if senha != confirmar_senha:

        print(
            "\n❌ As senhas não são iguais."
        )

        return

    if len(senha) < 6:

        print(
            "\n❌ A senha deve ter pelo menos 6 caracteres."
        )

        return

    try:

        resultado = supabase.auth.sign_up({

            "email": email,

            "password": senha,

            "options": {
                "data": {
                    "nome": nome
                }
            }

        })

        if resultado.user:

            print(
                "\n✅ Usuário cadastrado com sucesso!"
            )

            print(
                f"📧 E-mail: {email}"
            )

            if resultado.session is None:

                print(
                    "\n📧 Verifique seu e-mail "
                    "para confirmar a conta."
                )

            else:

                print(
                    "\n✅ Conta criada e usuário conectado."
                )

        else:

            print(
                "\n❌ Não foi possível cadastrar o usuário."
            )

    except Exception as erro:

        print(
            f"\n❌ Erro no cadastro:"
        )

        print(erro)


