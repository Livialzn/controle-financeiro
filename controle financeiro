# =========================================================
# BUSCAR TRANSAÇÕES DO USUÁRIO
# =========================================================

def buscar_transacoes():

    user_id = pegar_usuario_id()

    if not user_id:

        return []

    try:

        resultado = (
            supabase
            .table("transacoes")
            .select(
                """
                id,
                descricao,
                valor,
                tipo,
                data_movimento,
                categoria_id,
                categorias (
                    nome
                )
                """
            )
            .eq(
                "user_id",
                user_id
            )
            .order(
                "data_movimento",
                desc=True
            )
            .execute()
        )

        return resultado.data

    except Exception as erro:

        print(
            "\n❌ Erro ao buscar transações:"
        )

        print(erro)

        return []


# =========================================================
# CALCULAR SALDO
# =========================================================

def calcular_saldo():

    transacoes = buscar_transacoes()

    saldo = 0.0

    for transacao in transacoes:

        valor = float(
            transacao["valor"]
        )

        if transacao["tipo"] == "entrada":

            saldo += valor

        elif transacao["tipo"] == "saida":

            saldo -= valor

    return saldo


